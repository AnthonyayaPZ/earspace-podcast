# Generate .env and a random key: uv run --locked scripts/init_env.py
EARSPACE_API_KEY=replace-with-a-random-secret-at-least-24-characters
EARSPACE_DATA_DIR=./data
# Enable YouTube Data API v3 in your Google Cloud project.
YOUTUBE_API_KEY=
# Optional Netscape cookie file, exported by you from a YouTube browser session.
# Local example: EARSPACE_YOUTUBE_COOKIES_FILE=./secrets/youtube.cookies.txt
# With compose.cookies.yaml, set this to the absolute file path on the Docker host.
EARSPACE_YOUTUBE_COOKIES_FILE=
# Exact frontend origins, comma separated. Empty means same-origin only.
EARSPACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EARSPACE_SEARCH_TTL_SECONDS=21600
EARSPACE_JOB_TIMEOUT_SECONDS=7200
EARSPACE_JOB_MAX_ATTEMPTS=2
EARSPACE_MAX_DURATION_SECONDS=14400
EARSPACE_MAX_FILE_MB=2048
EARSPACE_MIN_FREE_MB=2048
# Optional CPU transcription (uv sync --locked --extra transcription first).
EARSPACE_WHISPER_ENABLED=false
EARSPACE_WHISPER_MODEL=small
